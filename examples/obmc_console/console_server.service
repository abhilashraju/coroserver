[Unit]
Description=OpenBMC Console Server
Documentation=man:console-server(8)
After=network.target
# Wait for the UART device to be available
After=dev-ttyS0.device
Wants=dev-ttyS0.device

[Service]
Type=simple
# Wrapper script reads /run/openbmc/bmc_position (0 or 1) to set the last
# octet of remote-host, writes the resolved config to /run/obmc-console/, then
# exec's console_server.  Falls back to octet 0 if the file is absent.
ExecStart=/usr/bin/obmc-console-start.sh
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/tmp /var/log /run /run/obmc-console

# Resource limits
LimitNOFILE=65536

# D-Bus integration
BusName=xyz.openbmc_project.Console.default

[Install]
WantedBy=multi-user.target